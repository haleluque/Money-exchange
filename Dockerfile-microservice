# First Stage: 'build' stage with Maven
FROM openjdk:21-jdk-slim AS build

# Install Maven and clean up unnecessary files
RUN apt-get update && apt-get install -y maven && rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR /app

# Copy the project files
COPY . .

# Build the application and create the Docker image using Spring Boot
RUN mvn clean package spring-boot:build-image -DskipTests

# Second Stage: 'runtime' stage with OpenJDK 21
FROM openjdk:21-jdk-slim

# Copy the built JAR file from the build stage
COPY --from=build /app/target/*.jar app.jar

# Set the entry point to run the application
ENTRYPOINT ["java", "-jar", "/app.jar"]
